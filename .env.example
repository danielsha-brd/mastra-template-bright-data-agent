# Bright Data: powers every web request the agent makes.
# Create a free token at https://brightdata.com/cp/setting/users
# New accounts include 5,000 requests per month, no credit card.
BRIGHT_DATA_API_TOKEN=

# OpenAI: the model the agent runs on.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: swap the default search-and-scrape tools for the structured-data
# tools of one platform group. Leave empty unless you need a specific platform.
#   ecommerce  Amazon, Walmart, eBay, Best Buy, Etsy, Home Depot, Zara, Google Shopping
#   social     LinkedIn, Instagram, TikTok, YouTube, X, Reddit, Facebook
#   business   Crunchbase, ZoomInfo, Google Maps reviews, Zillow, Booking.com
#   browser    remote browser automation (click, type, screenshot)
#   geo        ChatGPT, Grok, and Perplexity answers as structured data
# The hosted server applies one group only, and setting a group removes the
# search_engine_batch and scrape_batch tools. An unrecognized group name is
# ignored without an error and you get the default tools back.
BRIGHT_DATA_MCP_GROUPS=
